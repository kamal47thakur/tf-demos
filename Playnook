username=unixsvc

echo -e " "Hostname" \t "SudoFilesList" \t "OS" " > /home/unixsvc/kdata/osversion.xls
#echo -e " "Hostname" \t "Kernel" " > /home/unixsvc/kdata/osversion.xls
