cat CheckUnixPatchSudo_User.yml;cat copy.yml;cat msdscan.yml;cat tlog.yml
---
- hosts: all
  become: yes
  become_user: root
  gather_facts: no

  tasks:
  - name: Get packages that can be upgraded on TEST servers
    ansible.builtin.yum:
      list: updates
      state: latest
        #    exclude: java*
      update_cache: yes
    register: reg_yum_output_all
  - name: List packages that will be upgraded on TEST servers
    ansible.builtin.debug:
      msg: "{{ reg_yum_output_all.results | map(attribute='name') | list }}"
---
  - name: copy Sanity Logs Collect Script
    hosts: all
    become: yes
      #    become_user: root
    tasks:
      - name: Copy SanityScript
        ansible.builtin.copy:
          src: /home/unixsvc/sanityscript.sh
          dest: /home/unixsvc/sanityscript.sh
          owner: unixsvc
          group: unixsvc
          mode: '0777'
          backup: yes
      - name: Run SanityScript
        shell: 'mkdir /tmp/sanitylogs;sh /home/unixsvc/sanityscript.sh >>/tmp/sanitylogs/Presanity_$(hostname)-$(date +"%Y-%m-%d-%H-%M-%S");chmod -Rv 777 /tmp/sanitylogs'
      - name: Fetch SanityLog File from server
        shell: "ls -l /tmp/sanitylogs/*-$(date +%Y-%m-%d)-* |awk {'print $9'}"
        register: sanitylogfile

      - name: Download SanityLogs from server to Ansible
        fetch:
          src: "{{ sanitylogfile.stdout }}"
          dest: /home/unixsvc/kdata/playbook/sanitylog/
          flat: yes
---
- hosts: all
  strategy: free
  gather_facts: no
  become: yes
  tasks:
  - name: MSD Quick Scan Started
    shell: sudo /bin/mdatp scan quick;echo;hostname
    register: scan
  - name: MSD Scan Result
    debug:
      msg: "{{ scan.stdout_lines | to_nice_json}}"
  - local_action:
      module: copy
      content: "{{ scan.stdout_lines | to_nice_json }}"
      dest: "/tmp/scan.json"
    delegate_to: localhost
  - name: MSD Scan Status Report
    shell: sh msdscancheck.sh
    delegate_to: localhost
---
  - name: Copy TLogs from all server to Ansible Server
    hosts: all
    become: yes
    vars:
      date: "{{ lookup('pipe', 'date +%b-%d-%Y') }}"
    tasks:
     - name: Create Today Tlog Directory
       ansible.builtin.file:
          path: /home/unixsvc/tlog/tloglog-{{date}}
          state: directory
          mode: '0755'
          group: unixsvc
          owner: unixsvc
       register: local_dir
       delegate_to: localhost
     - name: Fetch Tlog File from server
       shell: "ls -l /var/log/tlog/old/* |awk {'print $9'} |tail -n 1"
       register: tlogfile

     - name: Download TLogs from server to Ansible
       fetch:
          src: "{{ tlogfile.stdout }}"
          dest: /home/unixsvc/tlog/tloglog-{{date}}/
          flat: yes

