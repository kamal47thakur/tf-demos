#for line in $(cat /home/unixsvc/kdata/inventory/ProdList)
for line in $(cat /home/unixsvc/kdata/testlist)
do
ssh -t $username@$line '(
host=`hostname`;
ip=`hostname -i`;
uptime=`uptime |cut -c14-20`;
os=`cat /etc/os-release |grep PRETTY_NAME |cut -c14-555555`;
kernel=` uname -r`
mem=`free -g |grep Mem |cut -c19-25`
swp=`free -g |grep Swap |cut -c19-25`
cpu=`lscpu |grep "CPU(s):" |grep -v NUMA |cut -c39-42`
echo -e " "$host" \t $ip \t "$uptime" \t "$os" \t "$kernel" \t "$mem" \t "$cpu" \t "$swp" "
#echo -e " "$host" \t "$kernel" "
)'  >>/home/unixsvc/kdata/osversion.xls
done
echo -e "OS Version report " | mutt  -s "OS Version Report"  kamal.kishore@towerswatson.com -a /home/unixsvc/kdata/osversion.xls
sleep 4
#!/bin/bash
