#!/bin/bash
COUNT=4
username=unixsvc

echo -e " "Hostname" \t "CPU" \t "MEM1"\t "MEM2"  " > /home/unixsvc/kdata/osversion.xls
for line in $(cat /home/unixsvc/kdata/serverlist)
do
ssh -t $username@$line '(
host=`hostname`;
cpu=`cat /proc/cpuinfo |grep -i processor |wc -l`;
mem=`/usr/bin/sudo /usr/sbin/dmidecode -t memory |grep Size |grep -v Installed`;
mem2=`/usr/bin/free -m `
echo -e " "$host" \t "$cpu" \t "$mem" \t "$mem2"  "
)'  >>/home/unixsvc/kdata/osversion.xls
done
echo -e "OS Version report " | mailx  -s "OS Version Report" -a /home/unixsvc/kdata/osversion.xls kamal.kishore@toweswatson.com
sleep 4
#!/bin/bash
COUNT=4
username=unixsvc

echo -e " "Hostname" \t IP \t "Uptime" \t "OS"  \t "Kernel" \t memory \t CPU \t Swap " > /home/unixsvc/kdata/osversion.xls
