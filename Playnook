cat PatchAndRebootSudoUser.yml;cat CheckUnixPatchSudo_User.yml;cat jenkinsFilesystemMigration.yml;cat jenkinsFilesystemMigration.yml;
---
  - name: Patch the server and Reboot
    hosts: all
    gather_facts: no
    tasks:
      - name: Patch the server
        become: yes
        become_user: root
        tags: Patch
        shell: "yum -y update --skip-broken"
        register: patchresult

      - name: Reboot the server
        tags: reboot
        become: yes
        become_user: root
        shell: "sleep 5 && reboot"
        async: 1
        poll: 0

      - name: Wait for the reboot to complete if there was a change.
        wait_for_connection:
          connect_timeout: 60
          sleep: 60
          delay: 60
          timeout: 300

      - name: Check the Uptime of the servers
        shell: "uptime"
        register: Uptime

      - debug: var=Uptime
---
